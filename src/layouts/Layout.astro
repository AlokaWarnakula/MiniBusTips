---
import "../styles/global.css";
const { title = "Kohomada Bus? – Sri Lanka bus route & live status" } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: "/", label: "Find Route" },
  { href: "/report", label: "Live Reports" },
  { href: "/about", label: "About" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="Find Sri Lankan bus routes and fares, and see live crowd-sourced status of each route before you leave home." />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col app-shell">
    <header class="bg-[#fffdf8]/90 backdrop-blur border-b border-amber-100 sticky top-0 z-10">
      <div class="mx-auto max-w-4xl px-4 flex items-center justify-between h-16">
        <a href="/" class="flex items-center gap-2 font-extrabold text-[15px] tracking-tight text-slate-900">
          <span class="brand-mark grid h-9 w-9 place-items-center rounded-xl bg-amber-400 text-lg">🚌</span>
          <span>Kohomada <span class="text-amber-700">Bus?</span></span>
        </a>
        <nav class="flex gap-1 text-xs sm:text-sm">
          {nav.map((n) => (
            <a
              href={n.href}
              class={`px-3 py-1.5 rounded-md ${
                path === n.href ? "bg-slate-900 text-white shadow-sm" : "text-slate-600 hover:bg-amber-100"
              }`}
            >
              {n.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main class="mx-auto w-full max-w-4xl px-4 py-5 sm:py-8 flex-1">
      <slot />
    </main>

    <footer class="border-t border-amber-100 bg-[#fffdf8]">
      <div class="mx-auto max-w-4xl px-4 py-5 text-xs text-slate-500">
        Made for Sri Lankan commuters · Fares are estimates for guidance only.
      </div>
    </footer>
  </body>
</html>
