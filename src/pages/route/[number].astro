---
import Layout from "../../layouts/Layout.astro";
import FareCalculator from "../../components/FareCalculator.tsx";
import ReportList from "../../components/ReportList.tsx";
import { getRoute } from "../../lib/routes";
export const prerender = false;

const { number } = Astro.params;
const route = getRoute(number ?? "");
if (!route) Astro.response.status = 404;
---

{!route && (
  <Layout title="Route not found · Kohomada Bus?">
    <div class="text-center py-16">
      <div class="text-4xl mb-3">🚏</div>
      <h1 class="text-xl font-bold">We don't have that route</h1>
      <p class="text-sm text-gray-500 mt-1">Route "{number}" isn't in our list yet. Pick one from the route search.</p>
      <a href="/" class="inline-block mt-4 bg-gray-900 text-white rounded-md px-4 py-2 text-sm">Back to route search</a>
    </div>
  </Layout>
)}

{route && (

<Layout title={`Route ${route.number} — ${route.name} · Kohomada Bus?`}>
  <a href="/" class="inline-flex items-center gap-1 text-sm font-medium text-slate-500 hover:text-slate-900">&larr; All routes</a>

  <header class="mt-4 mb-6 rounded-3xl bg-slate-900 px-5 py-6 text-white sm:px-7">
    <p class="mb-2 text-xs font-bold uppercase tracking-[.18em] text-amber-300">Bus route</p>
    <h1 class="flex items-center gap-3 text-2xl font-extrabold sm:text-3xl"><span class="rounded-xl bg-amber-400 px-3 py-1.5 text-slate-900">{route.number}</span>{route.name}</h1>
    <p class="mt-3 text-sm text-slate-300">via {route.via} · {route.highway} · {route.operator}</p>
  </header>

  <div class="grid md:grid-cols-2 gap-6">
    <section>
      <section class="surface rounded-2xl border border-amber-100 bg-white p-5">
      <div class="mb-4 flex items-center gap-2"><span class="grid h-8 w-8 place-items-center rounded-lg bg-amber-100">📍</span><h2 class="font-extrabold">Stops on this route</h2></div>
      <ol class="relative ml-2 border-l-2 border-amber-200">
        {route.stops.map((s) => (
          <li class="ml-4 pb-4 last:pb-0">
            <span class="absolute -left-[7px] w-3 h-3 rounded-full bg-amber-400 ring-4 ring-amber-50"></span>
            <div class="text-sm font-bold">{s.name}</div>
            <div class="text-xs text-slate-400">{s.km} km from start</div>
          </li>
        ))}
      </ol></section>
    </section>

   