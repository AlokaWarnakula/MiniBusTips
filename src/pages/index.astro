---
import Layout from "../layouts/Layout.astro";
import RouteSearch from "../components/RouteSearch.tsx";
import RouteGrid from "../components/RouteGrid.tsx";
import { ROUTES, allStopNames } from "../lib/routes";
export const prerender = false;
---

<Layout>
  <section class="relative overflow-hidden rounded-3xl bg-slate-900 px-5 py-7 text-white sm:px-8 sm:py-10">
    <div class="absolute -right-12 -top-14 h-44 w-44 rounded-full bg-amber-400/20"></div>
    <div class="absolute right-12 bottom-0 text-7xl opacity-15">🚌</div>
    <div class="relative max-w-xl">
      <p class="mb-2 text-xs font-bold uppercase tracking-[.18em] text-amber-300">Your commute, less uncertain</p>
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Find your bus before you leave.</h1>
      <p class="mt-3 text-sm leading-relaxed text-slate-300 sm:text-base">Check a route, estimate your fare, and see what fellow passengers are reporting right now.</p>
    </div>
  </section>

  <RouteSearch client:load routes={ROUTES} stops={allStopNames()} />

  <section class="mt-9">
    <div class="flex items-end justify-between mb-3">
      <div><p class="text-xs font-bold uppercase tracking-wider text-amber-700">Explore</p><h2 class="text-xl font-extrabold">Routes near Colombo</h2></div>
      <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-800">{ROUTES.length} routes</span>
    </div>
    <p class="text-xs text-slate-500 mb-3">Live status is based on rider reports from the last 2 hours.</p>
    <RouteGrid client:load routes={ROUTES} />
  </section>
</Layout>
