---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Not found · Kohomada Bus?">
  <div class="text-center py-16">
    <div class="text-4xl mb-3">🚏</div>
    <h1 class="text-xl font-bold">This stop doesn't exist</h1>
    <p class="text-sm text-gray-500 mt-1">The page you asked for isn't on any of our routes.</p>
    <a href="/" class="inline-block mt-4 bg-gray-900 text-white rounded-md px-4 py-2 text-sm">
      Back to route search
    </a>
  </div>
</Layout>
